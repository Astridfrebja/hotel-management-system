@model ErrorViewModel
@{
    ViewData["Title"] = "Feil";
}

<h1 class="text-danger">Feil.</h1>
<h2 class="text-danger">Det oppstod en feil under behandlingen av forespørselen.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Forespørsels-ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Utviklermodus</h3>
<p>
    Bytt til <strong>Development</strong>-miljøet for å vise mer detaljert informasjon om feilen.
</p>
<p>
    <strong>Utviklermiljøet skal ikke være slått på for publiserte applikasjoner.</strong>
    Det kan vise sensitiv informasjon fra unntak til sluttbrukere.
    For lokal feilsøking setter du miljøvariabelen <strong>ASPNETCORE_ENVIRONMENT</strong> til <strong>Development</strong>
    og starter appen på nytt.
</p>
