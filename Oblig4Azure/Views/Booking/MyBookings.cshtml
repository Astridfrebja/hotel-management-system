@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Mine reservasjoner";
}

<h1>Mine reservasjoner</h1>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Romtype</th>
                <th>Innsjekk</th>
                <th>Utsjekk</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Room?.RoomType</td>
                    <td>@booking.CheckIn.ToShortDateString()</td>
                    <td>@booking.CheckOut.ToShortDateString()</td>
                    <td>@UiText.Status(booking.Status)</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Du har ingen reservasjoner <a asp-controller="Booking" asp-action="Search">søk her</a></p>
}
